# ==========================================
# 1. Enduroco Authentication
# ==========================================
# Option A: Leave blank to use interactive Google Sign-In (saved in .browser_profile)
# Option B: Paste your Firebase/Bearer token directly:
ENDUROCO_AUTH_TOKEN=

# ==========================================
# 2. TrainingPeaks Credentials
# ==========================================
# Option A: Web Login Credentials (Username & Password)
TRAININGPEAKS_USERNAME=
TRAININGPEAKS_PASSWORD=

# Option B: TrainingPeaks API Access Token (if using developer API)
TRAININGPEAKS_ACCESS_TOKEN=

# ==========================================
# 3. COROS Training Hub Credentials (Optional)
# ==========================================
COROS_EMAIL=
COROS_PASSWORD=

# Settings
SYNC_DAYS_AHEAD=7

